APP_ENV=development

# --- Database ---
# Local/dev default (SQLite, zero setup). For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://lifeline:lifeline@postgres:5432/lifeline
DATABASE_URL=sqlite:///backend/lifeline.db

# --- Cache (optional; falls back to in-process cache automatically) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI (optional; without a key the RAG pipeline runs in a deterministic offline mode) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Maps (optional; falls back to a haversine-distance ETA estimate) ---
GOOGLE_MAPS_API_KEY=

# --- Storage ---
STORAGE_BACKEND=local
UPLOAD_DIR=backend/uploads
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_PATH=

# --- Notifications (mocked/logged unless configured) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Demo behaviour ---
SIMULATE_TRAVEL=true
DEMO_TICK_SECONDS=4
PIPELINE_STEP_DELAY=1.2
