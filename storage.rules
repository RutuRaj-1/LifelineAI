rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAllowedFileType() {
      return request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/plain');
    }

    function isUnderSizeLimit() {
      return request.resource.size < 15 * 1024 * 1024; // 15 MB
    }

    // Patient uploaded records (Health Vault)
    match /patients/{patientId}/{fileName} {
      allow read: if true;
      allow write: if isAllowedFileType() && isUnderSizeLimit();
    }

    // Emergency case documents & official discharge cards
    match /emergencies/{caseId}/{fileName} {
      allow read: if true;
      allow write: if isAllowedFileType() && isUnderSizeLimit();
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isUnderSizeLimit();
    }
  }
}
